# sandbox/.env.example — copy to sandbox/.env (gitignored) and fill in.
# Secrets are injected at RUNTIME only. Never bake these into the image.
#
# NOTHING IN THIS FILE IS AWS. The coding-agent VM must not hold trading credentials.

# GitHub token for the Ralph loop (issue read, feature-branch push, PR open).
# Use a FINE-GRAINED personal access token scoped to the falcon-stats repo ONLY,
# with Contents: read/write, Issues: read/write, Pull requests: read/write.
# Do NOT use a classic token or an org-admin token — a compromised agent inherits
# whatever this token can do. Branch protection on `main` is your backstop.
GH_TOKEN=

# Optional: Anthropic API key IF you run Claude Code in API-key mode instead of the
# persistent OAuth volume. Leave blank to rely on the claude-config volume.
ANTHROPIC_API_KEY=
